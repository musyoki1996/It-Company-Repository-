# ==============================================================================
# INFRANOVIX TECHNOLOGIES - Node.js Production Environment Variables
# ==============================================================================

# NODE_ENV: Set to 'production' for cPanel / production hosting.
# When set to 'production', the Node server serves the compiled 'dist' bundle
# and ignores development middleware.
NODE_ENV=production

# PORT: The port your Node.js application listens on.
# In cPanel "Setup Node.js App" (CloudLinux Passenger), cPanel manages the socket / port automatically.
# If running standalone or on custom VPS, set this to 3000 (or your assigned port).
PORT=3000

# APP_URL: The public web address where this app is hosted.
# Example: https://infranovix.co.ke
APP_URL=https://infranovix.co.ke

# ADMIN_PIN: Administrative portal access PIN (overrides the default in data/db.json).
# Default fallback: infranovix2026
ADMIN_PIN=infranovix2026

# TZ: Application server timezone for inquiries and quotation timestamps.
TZ=Africa/Nairobi

# GEMINI_API_KEY: Optional Gemini API key if AI assistance features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

